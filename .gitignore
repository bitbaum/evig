# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.selfhost.local.example

# typescript
*.tsbuildinfo
next-env.d.ts

# strapi
/strapi

# test results and reports
test-results/
test-results.json
*.bak
playwright-report/
tests/e2e/.auth/
coverage/

# screenshots and temporary images
*.png
*.jpg
*.jpeg
*.gif
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.gif

# temporary files and system files
.DS_Store
Thumbs.db
*.tmp
*.temp

# editor and IDE files
.vscode/
.idea/
*.swp
*.swo
.cursor/
.claude/

# docker (if not using docker deployment)
Dockerfile.dev
docker-compose.dev.yml

# Database files and uploads
# Legacy cms-api/ subproject is no longer tracked — keep the whole dir
# out of git in case a stale local checkout still has it.
cms-api/
*.sqlite
*.db

# Build artifacts and caches
dist/
build/
.cache/
.parcel-cache/

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Archive and legacy files
archive/
legacy/
tina/__generated__

.env*.local

# Uploaded files (development)
public/uploads/
# Ad-hoc one-off scripts get dropped at the repo ROOT while debugging — keep
# those out, but ONLY those. This used to be a blanket `*.sh` plus a hand-kept
# list of negations, which meant every new script under scripts/ was silently
# invisible to git: it committed clean, then CI or the deploy failed on a file
# that only ever existed on one laptop. Everything under scripts/ is part of the
# build/deploy contract (workflows and other scripts source it by path), so the
# default there is tracked.
/*.sh
ship
cookies.txt
daten/
docker-compose.override.yml

# Presentations served from public/ (unlisted, share-by-link)
!public/presentations/
.playwright-mcp/
public/sitemap.xml
messages/_missing/
.env.selfhost.local
