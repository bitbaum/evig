    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^17.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "@opentelemetry/core": "^2.8.0",
    "fast-xml-parser": "^5.3.6",
    "ajv": "^6.14.0",
    "minimatch": "^10.2.1",
    "nodemailer": "^9.0.1",
    "js-yaml": "^4.3.1",
    "basic-ftp": ">=5.3.0",
    "postcss": "^8.5.26",
    "esbuild": "0.28.1",
    "shell-quote": "1.10.0",
    "brace-expansion": "^5.0.9",
    "uuid": "$uuid",
    "sharp": "$sharp"
  }
